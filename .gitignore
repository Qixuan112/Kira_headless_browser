# Cookie 目录包含用户会话凭证，禁止提交到版本库
# 已在 manifest.json 的 exclude 字段中声明打包排除
data/files/cookie/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 插件运行时数据
# 框架在插件目录下写的运行日志（导入插件时会自动生成）
data/log.log
data/*.log
screenshots/
downloads/
browser_profile/
inherited_profile/
data/plugins/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# 回归测试产物
regression/js/node_modules/
regression/__pycache__/
regression/checks/__pycache__/
regression/stubs/**/__pycache__/
regression/_ext_client.mjs
regression/kira_ext_client_*.mjs
regression/**/kira_ext_client_*.mjs
regression/js/_click_runner_*.mjs

# 插件目录下的运行期临时产物。
# ⚠️ 原来只忽略了 data/*.log，漏了 data/temp/ —— 而回归测试（以及真机运行）
#    会在这里落截图 / VLM 压缩图这类二进制垃圾。漏掉它的后果是
#    "跑一遍测试 → git status 多出几个 MB 的图片"，很容易被顺手 git add -A
#    带进提交（本项目就发生过一次：一次 PR 里混进 4 张 662KB 的图，
#    把 diff 撑到 2.8MB）。运行时产物一律不该进版本库。
data/temp/
data/downloads/

