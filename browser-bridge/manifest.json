{
  "manifest_version": 3,
  "name": "Kira Browser Bridge",
  "version": "1.5.4",
  "description": "让 KiraAI 感知并操作你的浏览器（Chrome / Edge / Brave 等 Chromium 系）。支持读页面、点击、输入、执行 JS、上传下载文件。权限由 KiraAI 插件配置控制。",
  "minimum_chrome_version": "135",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "webNavigation",
    "activeTab",
    "cookies",
    "history",
    "bookmarks",
    "downloads",
    "clipboardRead",
    "clipboardWrite",
    "userScripts"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kira Browser Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "pairing-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {}
}
